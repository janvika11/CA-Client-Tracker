# Server Configuration
PORT=5000
NODE_ENV=development

# Dev only: omit or set true to accept any email/password (uses first DB user if email unknown).
# Set DEV_ALLOW_ANY_LOGIN=false to require real seeded credentials.
DEV_ALLOW_ANY_LOGIN=true

# MongoDB Configuration
# Atlas: paste from Atlas → Connect → Drivers (mongodb+srv://…).
# If you see querySrv ECONNREFUSED, use Atlas’s alternate "standard connection" (non‑SRV) string instead.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ca-tracker?retryWrites=true&w=majority
# Local only (no Atlas):
# MONGODB_URI=mongodb://127.0.0.1:27017/ca-tracker

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production_minimum_32_chars
JWT_EXPIRE=7d

# CORS: optional extra origin (https://ca-client-tracker.vercel.app + *.vercel.app + localhost dev ports are built-in in server.js)
CORS_ORIGIN=https://ca-client-tracker.vercel.app

# Production (NODE_ENV=production): auth cookie uses SameSite=None + Secure for Vercel→Render etc.
# TRUST_PROXY=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
