# Server Configuration
PORT=5000
NODE_ENV=development

# Dev only: omit or set true to accept any email/password (uses first DB user if email unknown).
# Set DEV_ALLOW_ANY_LOGIN=false to require real seeded credentials.
DEV_ALLOW_ANY_LOGIN=true

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/ca-tracker

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production_minimum_32_chars
JWT_EXPIRE=7d

# CORS Configuration (optional extra origin; 5173/5174 localhost + 127.0.0.1 are built-in)
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
